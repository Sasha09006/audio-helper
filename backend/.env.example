# 百炼（北京地域）：ASR、TTS
BAILIAN_API_KEY=
BAILIAN_REGION=cn-beijing
BAILIAN_ASR_MODEL=qwen3-asr-flash
BAILIAN_TTS_MODEL=qwen3-tts-flash
BAILIAN_TTS_VOICE=Cherry
# ASR：北京地域 DashScope 同步接口（官方文档）
BAILIAN_ASR_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
BAILIAN_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# DeepSeek：信息提取、推荐语
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# 高德 Web 服务 Key
AMAP_API_KEY=
AMAP_GEOCODE_ENDPOINT=https://restapi.amap.com/v3/geocode/geo
AMAP_POI_SEARCH_ENDPOINT=https://restapi.amap.com/v3/place/around

# 本地服务
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8003
FRONTEND_ORIGIN=http://localhost:5175
CORS_ALLOW_ORIGINS=["http://localhost:5175","http://127.0.0.1:5175"]
